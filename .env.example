# =============================================================================
# ProxyGateLLM v4.0.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Puter.js Authentication (Optional but recommended)
# -----------------------------------------------------------------------------
# Get your free token from: https://puter.com/#/account
PUTER_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Provider API Keys (Optional — enable more providers)
# -----------------------------------------------------------------------------
# Groq — ultra-fast inference (free tier available)
# Get key from: https://console.groq.com
GROQ_API_KEY=

# HuggingFace — free inference API
# Get key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# OpenRouter — free models + paid models
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio — free Gemini models (most generous free tier)
# Get key from: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Cerebras — fastest inference speed (free tier available)
# Get key from: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Cloudflare Workers AI — edge inference, 40+ models
# Get account ID + API token from: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cohere — Command models, strong multilingual (free tier available)
# Get key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# Disable Specific Providers
# -----------------------------------------------------------------------------
# Set to 'true' or '1' to disable a provider
DISABLE_PUTER=false
DISABLE_POLLINATIONS=false
DISABLE_DUCKDUCKGO=false
DISABLE_OPENROUTER=false
DISABLE_GROQ=false
DISABLE_HUGGINGFACE=false
DISABLE_G4F=false
DISABLE_BLACKBOX=false
DISABLE_PHIND=false
DISABLE_GOOGLE_AI=false
DISABLE_CEREBRAS=false
DISABLE_CLOUDFLARE=false
DISABLE_COHERE=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATELIMIT_WINDOW_MS=60000
RATELIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Set allowed origin(s) — leave empty for wildcard (*)
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# API Key Authentication (Optional)
# -----------------------------------------------------------------------------
# If set, all requests must include X-API-Key header or Authorization: Bearer
API_KEY=

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Interval for automatic provider health checks (ms)
HEALTH_CHECK_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Model Sync Configuration
# -----------------------------------------------------------------------------
# Interval for auto-fetching latest models from providers (ms)
MODEL_SYNC_INTERVAL_MS=3600000

# -----------------------------------------------------------------------------
# HTTPS Configuration (Optional)
# -----------------------------------------------------------------------------
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
